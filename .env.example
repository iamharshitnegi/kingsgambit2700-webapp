# Frontend (no trailing slash)
# Optional development-only demo. `npm run dev:demo` sets this automatically.
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Optional separate realtime service; leave unset when /ws/v1 shares the API proxy.
NEXT_PUBLIC_REALTIME_URL=ws://localhost:8081/ws/v1
API_BASE_URL=http://localhost:8080
EDITORIAL_CONTENT_ENABLED=false
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=

# Go services
KG_ENV=development
# Google OAuth Web application client ID; authorize http://localhost:3000.
KG_GOOGLE_CLIENT_ID=
KG_API_ADDR=:8080
KG_REALTIME_ADDR=:8081
KG_ALLOWED_ORIGINS=http://localhost:3000
# Optional reverse-proxy IPs/CIDRs. Empty ignores forwarded client addresses.
KG_TRUSTED_PROXIES=
KG_PUBLIC_API_URL=http://localhost:8080
KG_PUBLIC_WEB_URL=http://localhost:3000
KG_DATABASE_URL=postgres://kg2700:kg2700@localhost:5432/kg2700?sslmode=disable
KG_DATABASE_DIRECT_URL=postgres://kg2700:kg2700@localhost:5432/kg2700?sslmode=disable
KG_POSTGRES_PORT=5432
KG_REDIS_URL=redis://localhost:6379/0
KG_COOKIE_NAME=kg_session
KG_COOKIE_SECURE=false
KG_SESSION_HASH_KEY=replace-with-at-least-32-random-bytes
KG_CSRF_HASH_KEY=replace-with-a-different-32-byte-random-key
KG_TOTP_ENCRYPTION_KEY=bG9jYWwta2cyNzAwLXRvdHAta2V5LW1hdGVyaWFsLTE=
KG_MFA_CHALLENGE_TTL=5m
KG_MFA_RECENT_TTL=5m
KG_MAGIC_LINK_TTL=15m
KG_STUDENT_ACCESS_CODE_TTL=10m
KG_SESSION_IDLE_TTL=30m
KG_SESSION_ABSOLUTE_TTL=168h
KG_CSRF_TTL=30m

# Object storage and malware scanning
KG_S3_ENDPOINT=http://localhost:9090
KG_S3_REGION=us-east-1
KG_S3_ACCESS_KEY_ID=local-access-key
KG_S3_SECRET_ACCESS_KEY=local-secret-key
KG_S3_BUCKET_QUARANTINE=kg2700-quarantine
KG_S3_BUCKET_CLEAN=kg2700-clean
KG_S3_FORCE_PATH_STYLE=true
KG_CLAMAV_ADDR=localhost:3310
KG_UPLOAD_MAX_BYTES=10485760

# Local email; production uses Resend
KG_EMAIL_PROVIDER=smtp
KG_SMTP_HOST=localhost
KG_SMTP_PORT=1025
KG_SMTP_FROM=academy@kingsgambit2700.in
KG_RESEND_FROM="KingsGambit2700 <academy@kingsgambit2700.in>"
KG_RESEND_API_KEY=
KG_RESEND_WEBHOOK_SECRET=whsec_bG9jYWwtcmVzZW5kLXdlYmhvb2stc2VjcmV0LTAwMDE=

# Commerce and classroom providers. Empty values keep launch-gated adapters disabled.
KG_RAZORPAY_KEY_ID=
KG_RAZORPAY_KEY_SECRET=
KG_RAZORPAY_WEBHOOK_SECRET=local-razorpay-webhook-secret
KG_DAILY_BASE_URL=https://api.daily.co/v1
KG_DAILY_API_KEY=
KG_DAILY_WEBHOOK_SECRET=bG9jYWwtZGFpbHktd2ViaG9vay1zZWNyZXQ=
KG_WHATSAPP_ENABLED=false

# OpenTelemetry (optional locally)
KG_OTEL_EXPORTER_OTLP_ENDPOINT=
KG_OTEL_SERVICE_NAME=kg2700-api
KG_LOG_LEVEL=info
