# Separate from the root local .env. Keep the real deploy/vps/.env private.
WEB_DOMAIN=kingsgambit2700.in
API_DOMAIN=api.kingsgambit2700.in
ACME_EMAIL=
# Set a unique release name (for example a Git commit or release date).
RELEASE=initial
# Caddy has a stable private address so the API trusts only its forwarding.
DOCKER_SUBNET=172.30.27.0/24
CADDY_PRIVATE_IP=172.30.27.10

# Generate with: bash deploy/vps/init-env.sh
POSTGRES_PASSWORD=
KG_TOTP_ENCRYPTION_KEY=
KG_S3_ACCESS_KEY_ID=
KG_S3_SECRET_ACCESS_KEY=
# Random inactive-provider placeholders; replace with the provider's real
# signing secret before configuring that provider's webhooks.
KG_RAZORPAY_WEBHOOK_SECRET=
KG_RESEND_WEBHOOK_SECRET=
KG_DAILY_WEBHOOK_SECRET=

# Required: SMTP that actually delivers email. Mailpit is not used here.
KG_SMTP_HOST=smtp.gmail.com
KG_SMTP_PORT=587
KG_SMTP_USER=
KG_SMTP_PASSWORD=
KG_SMTP_FROM=
KG_GOOGLE_CLIENT_ID=
# Used by the one-off administrator setup, not an automatic role grant.
KG_BOOTSTRAP_ADMIN_EMAIL=

# Keep the already-tested dependency versions explicit; update deliberately.
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:4.52
CLAMAV_IMAGE=clamav/clamav:stable
