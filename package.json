    "autoprefixer": "^10.4.23",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.6",
    "sanity": "5.31.2",
    "tailwindcss": "^3.4.14",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
