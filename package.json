    "next": "16.4.5",
    "next-sanity": "11.6.13",
    "openapi-fetch": "^0.17.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-chessboard": "^5.8.6",
    "react-dom": "19.2.3",
    "sanitize-html": "^2.17.7",
    "stockfish": "19.0.0"
