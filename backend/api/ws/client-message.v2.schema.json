{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.kingsgambit2700.in/schemas/ws/client-message.v2.schema.json",
  "title": "KingsGambit2700 classroom client message v2",
  "oneOf": [
    {
      "$ref": "#/$defs/join"
    },
    {
      "$ref": "#/$defs/resume"
    },
    {
      "$ref": "#/$defs/move"
    },
    {
      "$ref": "#/$defs/setMode"
    },
    {
      "$ref": "#/$defs/loadPosition"
    },
    {
      "$ref": "#/$defs/closeBoard"
    },
    {
      "$ref": "#/$defs/featureCommand"
    },
    {
      "$ref": "#/$defs/ping"
    },
    {
      "$ref": "#/$defs/annotationCommand"
    },
    {
      "$ref": "#/$defs/undoCommand"
    },
    {
      "$ref": "#/$defs/checkpointCommand"
    },
    {
      "$ref": "#/$defs/restoreCheckpointCommand"
    },
    {
      "$ref": "#/$defs/deleteCheckpointCommand"
    },
    {
      "$ref": "#/$defs/countdownCommand"
    }
  ],
  "$defs": {
    "join": {
      "type": "object",
      "required": [
        "type",
        "commandId",
        "ticket"
      ],
      "properties": {
        "type": {
          "const": "join"
        },
        "commandId": {
          "$ref": "#/$defs/uuidv7"
        },
        "ticket": {
          "type": "string",
          "minLength": 40,
          "maxLength": 64
        }
      },
      "additionalProperties": false,
      "description": "Must be the first frame. Ticket is short-lived and single-use."
    },
    "uuidv7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "base": {
      "type": "object",
      "required": [
        "type",
        "commandId"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "commandId": {
          "$ref": "#/$defs/uuidv7"
        }
      }
    },
    "resume": {
      "type": "object",
      "required": [
        "type",
        "commandId",
        "afterRevision"
      ],
      "properties": {
        "type": {
          "const": "resume"
        },
        "commandId": {
          "$ref": "#/$defs/uuidv7"
        },
        "afterRevision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "move": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "type",
            "commandId",
            "expectedRevision",
            "move"
          ],
          "properties": {
            "type": {
              "const": "move"
            },
            "commandId": {
              "$ref": "#/$defs/uuidv7"
            },
            "expectedRevision": {
              "type": "integer",
              "minimum": 0
            },
            "move": {
              "type": "string",
              "minLength": 4,
              "maxLength": 8
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "setMode": {
      "type": "object",
      "required": [
        "type",
        "commandId",
        "expectedRevision",
        "mode"
      ],
      "properties": {
        "type": {
          "const": "setMode"
        },
        "commandId": {
          "$ref": "#/$defs/uuidv7"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "mode": {
          "enum": [
            "demonstration",
            "free_analysis",
            "student_turn",
            "private_response",
            "game_review",
            "engine_review"
          ]
        },
        "activeActorId": {
          "$ref": "#/$defs/uuidv7"
        }
      },
      "additionalProperties": false
    },
    "loadPosition": {
      "type": "object",
      "required": [
        "type",
        "commandId",
        "expectedRevision",
        "fen",
        "moves"
      ],
      "properties": {
        "type": {
          "const": "loadPosition"
        },
        "commandId": {
          "$ref": "#/$defs/uuidv7"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "fen": {
          "type": "string",
          "minLength": 1
        },
        "moves": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "string",
            "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$"
          }
        },
        "initialFen": {
          "type": "string",
          "maxLength": 200
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "moves": {
                "minItems": 1
              }
            }
          },
          "then": {
            "required": [
              "initialFen"
            ]
          }
        }
      ]
    },
    "closeBoard": {
      "type": "object",
      "required": [
        "type",
        "commandId",
        "expectedRevision"
      ],
      "properties": {
        "type": {
          "const": "closeBoard"
        },
        "commandId": {
          "$ref": "#/$defs/uuidv7"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "featureCommand": {
      "type": "object",
      "required": [
        "type",
        "commandId"
      ],
      "properties": {
        "type": {
          "enum": [
            "exerciseAssign",
            "privateResponse",
            "exerciseReveal",
            "presence",
            "providerState"
          ]
        },
        "commandId": {
          "$ref": "#/$defs/uuidv7"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "payload": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "Disabled private-response and provider commands never mutate shared state."
    },
    "ping": {
      "type": "object",
      "required": [
        "type",
        "commandId"
      ],
      "properties": {
        "type": {
          "const": "ping"
        },
        "commandId": {
          "$ref": "#/$defs/uuidv7"
        }
      },
      "additionalProperties": false
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startSquare",
        "endSquare",
        "color"
      ],
      "properties": {
        "startSquare": {
          "type": "string",
          "pattern": "^[a-h][1-8]$"
        },
        "endSquare": {
          "type": "string",
          "pattern": "^[a-h][1-8]$"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    },
    "annotationCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "commandId",
        "expectedRevision",
        "annotations"
      ],
      "properties": {
        "type": {
          "const": "annotation"
        },
        "commandId": {
          "$ref": "#/$defs/uuidv7"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "annotations": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/annotation"
          }
        }
      }
    },
    "undoCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "commandId",
        "expectedRevision"
      ],
      "properties": {
        "type": {
          "const": "undo"
        },
        "commandId": {
          "$ref": "#/$defs/uuidv7"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "checkpointCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "commandId",
        "expectedRevision",
        "title"
      ],
      "properties": {
        "type": {
          "const": "checkpoint"
        },
        "commandId": {
          "$ref": "#/$defs/uuidv7"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "restoreCheckpointCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "commandId",
        "expectedRevision",
        "checkpointId"
      ],
      "properties": {
        "type": {
          "const": "restoreCheckpoint"
        },
        "commandId": {
          "$ref": "#/$defs/uuidv7"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "checkpointId": {
          "$ref": "#/$defs/uuidv7"
        }
      }
    },
    "deleteCheckpointCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "commandId",
        "expectedRevision",
        "checkpointId"
      ],
      "properties": {
        "type": {
          "const": "deleteCheckpoint"
        },
        "commandId": {
          "$ref": "#/$defs/uuidv7"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "checkpointId": {
          "$ref": "#/$defs/uuidv7"
        }
      }
    },
    "countdownCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "commandId",
        "expectedRevision",
        "seconds"
      ],
      "properties": {
        "type": {
          "const": "countdown"
        },
        "commandId": {
          "$ref": "#/$defs/uuidv7"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10800
        },
        "label": {
          "type": "string",
          "maxLength": 100
        }
      }
    }
  }
}
